rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUserMember(wgId, userId) {
      return exists(/databases/$(database)/documents/wgs/$(wgId)/memberships/$(userId));
    }

    function isMember(wgId) {
      return signedIn() && isUserMember(wgId, request.auth.uid);
    }

        function isValidDisplayNameFor(userId, data) {
      return !('displayName' in data)
        || (
          data.displayName is string
          && data.displayName.size() >= 2
          && data.displayName.size() <= 50
          && data.displayName.matches('.*[^ \\t\\r\\n].*')
          && get(/databases/$(database)/documents/users/$(userId)).data.name.trim() == data.displayName
        );
    }

    function migratesOwnDisplayName(wgId, userId) {
      return signedIn()
        && request.auth.uid == userId
        && resource.data.userId == userId
        && resource.data.wgId == wgId
        && !('displayName' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.displayName.matches('.*[^ \\t\\r\\n].*')
        && get(/databases/$(database)/documents/users/$(userId)).data.name.trim() == request.resource.data.displayName;
    }

    function isValidShoppingItemData(data, wgId) {
      return data.keys().hasOnly(['wgId', 'name', 'description', 'quantity', 'category', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.wgId == wgId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.name.matches('.*[^ \\t\\r\\n].*')
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500 && data.description.matches('.*[^ \\t\\r\\n].*')))
        && (!('quantity' in data) || data.quantity == null || (data.quantity is int && data.quantity >= 1))
        && (!('category' in data) || data.category == null || data.category in ['lebensmittel', 'haushalt', 'hygiene', 'sonstiges'])
        && data.status is string
        && data.status in ['open', 'bought']
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function createsValidShoppingItem(wgId) {
      return isMember(wgId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidShoppingItemData(request.resource.data, wgId);
    }

    function updatesValidShoppingItem(wgId) {
      return isMember(wgId)
        && isValidShoppingItemData(request.resource.data, wgId)
        && request.resource.data.wgId == resource.data.wgId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == 'open' && (request.resource.data.status == 'open' || request.resource.data.status == 'bought'))
          || (resource.data.status == 'bought' && request.resource.data.status == 'bought')
        );
    }

    // UC-11 – Ausgabe erfassen.
    function isValidExpenseData(data, wgId) {
  return data.keys().hasOnly(['wgId', 'amount', 'description', 'paidBy', 'shoppingItemId', 'receiptUrl', 'createdAt', 'updatedAt'])
    && data.wgId == wgId
    && data.amount is number
    && data.amount > 0
    && data.description is string
    && data.description.matches('.*[^ \\t\\r\\n].*')
    && data.paidBy is string
    && isUserMember(wgId, data.paidBy)
    && (!('shoppingItemId' in data) || data.shoppingItemId == null || data.shoppingItemId is string)
    && (!('receiptUrl' in data) || data.receiptUrl == null || data.receiptUrl is string)
    && data.createdAt is timestamp
    && (!('updatedAt' in data) || data.updatedAt is timestamp);
}

function createsValidExpense(wgId) {
  return isMember(wgId)
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && isValidExpenseData(request.resource.data, wgId);
}

// UC-12 – Ausgabe bearbeiten: Betrag, Beschreibung und Zahler duerfen sich
// aendern; wgId, createdAt, shoppingItemId und receiptUrl bleiben unveraendert.
function updatesValidExpense(wgId, expenseId) {
  return isMember(wgId)
    && request.resource.data.wgId == resource.data.wgId
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.shoppingItemId == resource.data.shoppingItemId
    && request.resource.data.receiptUrl == resource.data.receiptUrl
    && request.resource.data.updatedAt == request.time
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'description', 'paidBy', 'updatedAt'])
    && isValidExpenseData(request.resource.data, wgId);
}

    function isValidExpenseShareData(data, wgId, expenseId) {
      return data.keys().hasOnly(['expenseId', 'userId', 'shareAmount'])
        && data.expenseId == expenseId
        && data.userId is string
        && isUserMember(wgId, data.userId)
        && data.shareAmount is number
        && data.shareAmount >= 0;
    }

// UC-13 – Kosten aufteilen (AF-06 Saldo berechnen).
//
// Debt gehoert zu genau einer Expense (Debt.expenseId, siehe D1.8 /
// A09 ADR-07). Die Dokument-ID ist deterministisch aus expenseId und
// debtorId gebildet, wodurch sie eindeutig an eine konkrete
// Kostenaufteilung gebunden ist. Zwischen denselben zwei Mitgliedern
// koennen mehrere Debts aus unterschiedlichen Ausgaben nebeneinander
// bestehen.
function isValidDebtData(data, wgId, debtId) {
  return data.keys().hasOnly(['wgId', 'expenseId', 'creditorId', 'debtorId', 'amount', 'status', 'paidAt', 'createdAt'])
    && data.wgId == wgId
    && data.expenseId is string
    && data.creditorId is string
    && data.debtorId is string
    && data.creditorId != data.debtorId
    && debtId == data.expenseId + '_' + data.debtorId
    && isUserMember(wgId, data.creditorId)
    && isUserMember(wgId, data.debtorId)
    && data.amount is number
    && data.amount > 0
    && data.status is string
    && data.status in ['open', 'paid']
    && (data.status == 'open' ? (!('paidAt' in data) || data.paidAt == null) : data.paidAt is timestamp)
    && data.createdAt is timestamp;
}

// Eine Debt darf nur zusammen mit ihrer Parent-Expense erzeugt werden: die
// Expense muss im selben atomaren Vorgang existieren, ihr paidBy muss dem
// Glaeubiger entsprechen, ihr updatedAt muss auf den aktuellen Request
// zeigen (schliesst aus, dass eine Debt zu einer unveraenderten,
// laengst abgeschlossenen Expense nachtraeglich erzeugt wird), und der
// deklarierte Betrag muss exakt dem persistierten ExpenseShare des
// Schuldners entsprechen.
function createsValidDebt(wgId, expenseId, debtId) {
  let expensePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId);
  let sharePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId)/expenseShares/$(request.resource.data.debtorId);
  return isMember(wgId)
    && isValidDebtData(request.resource.data, wgId, debtId)
    && request.resource.data.status == 'open'
    && request.resource.data.expenseId == expenseId
    && existsAfter(expensePath)
    && getAfter(expensePath).data.paidBy == request.resource.data.creditorId
    && getAfter(expensePath).data.updatedAt == request.time
    && existsAfter(sharePath)
    && getAfter(sharePath).data.userId == request.resource.data.debtorId
    && getAfter(sharePath).data.shareAmount == request.resource.data.amount;
}

// Update ist auf zwei Faelle beschraenkt: (a) UC-13 passt eine noch
// offene, zur aktuellen Kostenaufteilung gehoerende Debt an eine
// veraenderte Expense an (wgId/expenseId/debtorId/createdAt bleiben
// unveraendert, status bleibt open, amount muss wieder exakt dem
// aktuellen ExpenseShare entsprechen); (b) UC-15 markiert eine offene
// Debt als bezahlt (nur status und paidAt aendern sich). Eine bereits
// bezahlte Debt kann durch diese Funktion nicht mehr veraendert werden.
function updatesValidDebt(wgId, expenseId, debtId) {
  let expensePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId);
  let sharePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId)/expenseShares/$(resource.data.debtorId);
  return isMember(wgId)
    && resource.data.status == 'open'
    && request.resource.data.wgId == resource.data.wgId
    && request.resource.data.expenseId == resource.data.expenseId
    && request.resource.data.debtorId == resource.data.debtorId
    && request.resource.data.createdAt == resource.data.createdAt
    && (
      (
        // Fall (a): UC-13 aktualisiert die Debt zusammen mit ihrer Expense.
        isValidDebtData(request.resource.data, wgId, debtId)
        && request.resource.data.status == 'open'
        && existsAfter(expensePath)
        && getAfter(expensePath).data.paidBy == request.resource.data.creditorId
        && getAfter(expensePath).data.updatedAt == request.time
        && existsAfter(sharePath)
        && getAfter(sharePath).data.userId == request.resource.data.debtorId
        && getAfter(sharePath).data.shareAmount == request.resource.data.amount
            ) || (
        // Fall (b): UC-15 – nur der Schuldner darf seine eigene offene
        // Debt als bezahlt markieren. Dabei duerfen ausschliesslich
        // status und paidAt geaendert werden.
        isValidDebtData(request.resource.data, wgId, debtId)
        && request.auth.uid == resource.data.debtorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'paidAt'
        ])
        && request.resource.data.status == 'paid'
        && request.resource.data.paidAt == request.time
      )
    );
}

// Loeschen ist nur fuer eine noch offene Debt erlaubt, und nur im selben
// atomaren Vorgang, in dem die Parent-Expense aktualisiert wird (z.B.
// weil der Schuldner nicht mehr beteiligt ist oder selbst zum Zahler
// wurde). Eine bezahlte Debt kann nicht geloescht werden.
function deletesValidDebt(wgId, expenseId) {
  let expensePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId);
  let sharePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId)/expenseShares/$(resource.data.debtorId);

  return isMember(wgId)
    && resource.data.status == 'open'
    && resource.data.expenseId == expenseId
    && existsAfter(expensePath)
    && getAfter(expensePath).data.updatedAt == request.time
    && (
      !existsAfter(sharePath)
      || getAfter(expensePath).data.paidBy == resource.data.debtorId
    );
}

match /wgs/{wgId}/debts/{debtId} {
  allow read: if isMember(wgId)
    && (resource.data.creditorId == request.auth.uid || resource.data.debtorId == request.auth.uid);
  allow create: if signedIn() && createsValidDebt(wgId, request.resource.data.expenseId, debtId);
  allow update: if signedIn() && updatesValidDebt(wgId, resource.data.expenseId, debtId);
  allow delete: if signedIn() && deletesValidDebt(wgId, resource.data.expenseId);
}



    function createsValidExpenseShare(wgId, expenseId, shareId) {
  let expensePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId);

  return isMember(wgId)
    && shareId == request.resource.data.userId
    && existsAfter(expensePath)
    && getAfter(expensePath).data.updatedAt == request.time
    && isValidExpenseShareData(request.resource.data, wgId, expenseId);
}

    // UC-12 loescht bestehende ExpenseShares nur im selben atomaren Vorgang,
    // in dem auch die zugehoerige Parent-Expense aktualisiert wird
    // (updatedAt == request.time). Ein isoliertes Loeschen einzelner Shares
    // ausserhalb einer Expense-Aktualisierung bleibt damit ausgeschlossen.
    function deletesValidExpenseShare(wgId, expenseId, shareId) {
  let expensePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId);

  return isMember(wgId)
    && resource.data.expenseId == expenseId
    && shareId == resource.data.userId
    && existsAfter(expensePath)
    && getAfter(expensePath).data.updatedAt == request.time;
}

// UC-12 aktualisiert den Betrag eines bestehenden ExpenseShare nur im
// selben atomaren Vorgang, in dem auch die zugehoerige Parent-Expense
// aktualisiert wird. userId und expenseId bleiben unveraendert.
function updatesValidExpenseShare(wgId, expenseId, shareId) {
    let expensePath = /databases/$(database)/documents/wgs/$(wgId)/expenses/$(expenseId);

  return isMember(wgId)
    && resource.data.expenseId == expenseId
    && shareId == resource.data.userId
    && shareId == request.resource.data.userId
    && request.resource.data.expenseId == resource.data.expenseId
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareAmount'])
    && isValidExpenseShareData(request.resource.data,wgId,expenseId)
    && existsAfter(expensePath)
    && getAfter(expensePath).data.updatedAt == request.time;
}

    function createsWgWithReservedInviteCode(wgId) {
      return signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-Z0-9]{6}$')
        && !exists(/databases/$(database)/documents/userMemberships/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/userMemberships/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/userMemberships/$(request.auth.uid)).data.wgId == wgId
        && existsAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode))
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.wgId == wgId
        && getAfter(/databases/$(database)/documents/userMemberships/$(request.auth.uid)).data.inviteCode == request.resource.data.inviteCode;
    }

    function createsOwnInviteCode(inviteCode) {
      return signedIn()
        && request.resource.data.wgId is string
        && request.resource.data.wgName is string
        && existsAfter(/databases/$(database)/documents/wgs/$(request.resource.data.wgId))
        && getAfter(/databases/$(database)/documents/wgs/$(request.resource.data.wgId)).data.inviteCode == inviteCode
        && getAfter(/databases/$(database)/documents/wgs/$(request.resource.data.wgId)).data.name == request.resource.data.wgName
        && getAfter(/databases/$(database)/documents/wgs/$(request.resource.data.wgId)).data.createdBy == request.auth.uid;
    }

    function createsOwnUserMembership(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.wgId is string
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-Z0-9]{6}$')
        && !exists(/databases/$(database)/documents/userMemberships/$(userId))
        && existsAfter(/databases/$(database)/documents/wgs/$(request.resource.data.wgId))
        && existsAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode))
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.wgId == request.resource.data.wgId
        && existsAfter(/databases/$(database)/documents/wgs/$(request.resource.data.wgId)/memberships/$(userId));
      }

    function createsOwnWgAdminMembership(wgId, userId) {
      return request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.wgId == wgId
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/wgs/$(wgId))
        && existsAfter(/databases/$(database)/documents/wgs/$(wgId))
        && getAfter(/databases/$(database)/documents/wgs/$(wgId)).data.createdBy == request.auth.uid
        && isValidDisplayNameFor(userId, request.resource.data);
    }

        function deletesOwnUserMembership(userId) {
        return signedIn()
        && request.auth.uid == userId
        && resource.data.wgId is string
        && !existsAfter(
          /databases/$(database)/documents/wgs/$(resource.data.wgId)/memberships/$(userId)
        );
    }

    function leavesWgAsMember(wgId, userId) {
      return signedIn()
        && request.auth.uid == userId
        && resource.data.userId == userId
        && resource.data.wgId == wgId
        && resource.data.role == 'member'
        && !existsAfter(
          /databases/$(database)/documents/userMemberships/$(userId)
        );
    }

    match /users/{userId} {
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
    }

    match /userMemberships/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if createsOwnUserMembership(userId);
      allow update: if false;
      allow delete: if deletesOwnUserMembership(userId);
    }

    match /inviteCodes/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if createsOwnInviteCode(inviteCode);
      allow update, delete: if false;
    }

    match /wgs/{wgId} {
      allow read: if isMember(wgId);
      allow create: if createsWgWithReservedInviteCode(wgId);
      allow update: if false;
      allow delete: if false;
    }

    match /wgs/{wgId}/memberships/{userId} {
      allow read: if isMember(wgId);
      // UC-04 WG beitreten: eine member-Membership darf der Client seit
      // A09 ADR-08 nicht mehr direkt anlegen. Der Beitritt laeuft ueber die
      // Callable Function joinWg, die mit Firebase-Admin-Rechten schreibt und
      // dadurch diese Regel nicht durchlaeuft.
      allow create: if signedIn() && createsOwnWgAdminMembership(wgId, userId);
      allow update: if migratesOwnDisplayName(wgId, userId);
      allow delete: if leavesWgAsMember(wgId, userId);
    }

    match /wgs/{wgId}/shoppingItems/{itemId} {
      allow read: if isMember(wgId);
      allow create: if createsValidShoppingItem(wgId);
      allow update: if updatesValidShoppingItem(wgId);
      allow delete: if isMember(wgId);
    }

    // UC-11 – Ausgabe erfassen: nur das Anlegen ist freigeschaltet. Lesen wird
    // für den Screen ebenfalls nur WG-Mitgliedern erlaubt; spätere UC-12..UC-16
    // bleiben weiterhin gesperrt.
    match /wgs/{wgId}/expenses/{expenseId} {
      allow read: if isMember(wgId);
      allow create: if signedIn() && createsValidExpense(wgId);
      allow update: if signedIn() && updatesValidExpense(wgId, expenseId);
      allow delete: if false;
}

    match /wgs/{wgId}/expenses/{expenseId}/expenseShares/{shareId} {
      allow read: if isMember(wgId);
      allow create: if signedIn() && createsValidExpenseShare(wgId, expenseId, shareId);
      allow delete: if signedIn() && deletesValidExpenseShare(wgId, expenseId, shareId);
      allow update: if signedIn() && updatesValidExpenseShare(wgId, expenseId, shareId);
    }
  }
}
